ADMIN_DB_NAME=kkutudio_admin
ADMIN_DB_USERNAME=admin
ADMIN_DB_PASSWORD=admin
ADMIN_WEB_PORT=8081
# kkori-api 등 다른 프로젝트의 postgres가 기본 5432를 이미 쓰고 있을 수 있어 호스트 포트를 분리했다.
# 컨테이너 간 통신(admin-api -> postgres)은 5432 그대로 쓰므로 이 값은 호스트에서 직접 접속할 때만 영향을 준다.
ADMIN_DB_HOST_PORT=5433

# admin_user 테이블이 비어 있을 때만 최초 1회 사용되는 부트스트랩 관리자 계정.
# 로컬/개발 환경에서만 채워서 사용하고, 실제 값은 커밋하지 않는다.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=관리자

# kkori-api의 ADMIN_API_KEY와 동일한 값이어야 한다 (kkori-api/.env 참고).
# 실제 연동 전에는 docker network create kkori-shared 로 공유 네트워크를 먼저 만들어야 한다.
KKORI_ADMIN_API_KEY=
